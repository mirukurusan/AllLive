<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="RoomItemTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="24" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <Border CornerRadius="4 4 0 0">
                <Grid>
                    <Image Stretch="UniformToFill" Source="{Binding Path=Cover}" />
                    <Grid Padding="8" VerticalAlignment="Bottom">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Offset="0.993" Color="#66000005" />
                                <GradientStop Offset="0" Color="#00000000" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14">
                                <PathIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Data="{StaticResource IconHot}" Foreground="White" />
                            </Viewbox>
                            <TextBlock Margin="4,2,0,0" VerticalAlignment="Center" FontSize="12" Foreground="White">
                                <Run Text="{Binding Path=Online, Converter={StaticResource numberToStringConvert}}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Margin="4,4,4,0" MaxLines="1" Text="{Binding Path=Title}"
                TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Margin="4,0,4,4" FontSize="12" Foreground="Gray"
                Text="{Binding Path=UserName}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
