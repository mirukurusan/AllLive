<Page
    x:Class="AllLive.WinUI.Views.FavoritePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Windows10version1809="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 7)"
    xmlns:controls="using:AllLive.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AllLive.WinUI.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Padding="16,8">
            <TextBlock FontSize="24">我的关注</TextBlock>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Command="{x:Bind Path=favoriteVM.RefreshCommand}"
                    IsEnabled="{x:Bind Path=favoriteVM.CanRefresh, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ProgressRing
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            IsActive="True"
                            Visibility="{x:Bind Path=favoriteVM.LoadingLiveStatus, Mode=OneWay}" />
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluent}"
                            FontSize="14"
                            Glyph="&#xE895;"
                            Visibility="{x:Bind Path=favoriteVM.LoadingLiveStatus, Mode=OneWay, Converter={StaticResource displayConvert}}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            Text="刷新中…"
                            Visibility="{x:Bind Path=favoriteVM.LoadingLiveStatus, Mode=OneWay}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            Text="全部刷新"
                            Visibility="{x:Bind Path=favoriteVM.LoadingLiveStatus, Mode=OneWay, Converter={StaticResource displayConvert}}" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0" Command="{x:Bind Path=favoriteVM.InputCommand}">导入</Button>
                <Button Command="{x:Bind Path=favoriteVM.OutputCommand}">导出</Button>
                <HyperlinkButton
                    Margin="8,0,0,0"
                    VerticalContentAlignment="Center"
                    Command="{x:Bind Path=favoriteVM.TipCommand}">
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluent}"
                        FontSize="16"
                        Glyph="&#xE783;" />
                </HyperlinkButton>
            </StackPanel>
        </Grid>
        <!-- 分组条 -->
        <Grid Grid.Row="1" Padding="16,0,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="groupList"
                ItemsSource="{x:Bind Path=favoriteVM.Groups, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectedItem="{x:Bind Path=favoriteVM.SelectedGroup, Mode=OneWay}"
                SelectionChanged="groupList_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FavoriteGroupItem">
                        <Grid Padding="12,6">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="GroupRenameMenuItem_Click"
                                        Text="重命名"
                                        Visibility="{Binding IsSpecial, Converter={StaticResource displayConvert}}" />
                                    <MenuFlyoutItem
                                        Click="GroupDeleteMenuItem_Click"
                                        Icon="Delete"
                                        Text="删除"
                                        Visibility="{Binding IsSpecial, Converter={StaticResource displayConvert}}" />
                                    <MenuFlyoutSeparator Visibility="{Binding IsSpecial, Converter={StaticResource displayConvert}}" />
                                    <MenuFlyoutItem
                                        Click="GroupMoveLeftMenuItem_Click"
                                        Text="左移"
                                        Visibility="{Binding IsSpecial, Converter={StaticResource displayConvert}}" />
                                    <MenuFlyoutItem
                                        Click="GroupMoveRightMenuItem_Click"
                                        Text="右移"
                                        Visibility="{Binding IsSpecial, Converter={StaticResource displayConvert}}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                Grid.Column="1"
                Margin="4,0,0,0"
                Orientation="Horizontal">
                <Button
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Command="{x:Bind Path=favoriteVM.AddGroupCommand}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluent}"
                            FontSize="12"
                            Glyph="&#xE710;" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center">新建分组</TextBlock>
                    </StackPanel>
                </Button>
                <Button
                    Margin="4,0,0,0"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Command="{x:Bind Path=favoriteVM.RefreshCurrentGroupCommand}"
                    IsEnabled="{x:Bind Path=favoriteVM.CanRefresh, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluent}"
                            FontSize="12"
                            Glyph="&#xE72C;" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center">刷新当前分组</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <controls:MyAdaptiveGridView
                Margin="8,0,8,8"
                CanLoadMore="False"
                DesiredWidth="400"
                IsItemClickEnabled="True"
                ItemClick="ls_ItemClick"
                ItemHeight="72"
                ItemsSource="{x:Bind Path=favoriteVM.CurrentItems, Mode=OneWay}"
                SelectionMode="None"
                StretchContentForSingleRow="False">
                <controls:MyAdaptiveGridView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource GridViewItemCornerRadiusStyle}" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                    </Style>
                </controls:MyAdaptiveGridView.ItemContainerStyle>
                <controls:MyAdaptiveGridView.ItemTemplate>
                    <DataTemplate x:DataType="models:FavoriteItem">
                        <Grid>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="SetGroupMenuItem_Click"
                                        Icon="Folder"
                                        Text="设置分组" />
                                    <MenuFlyoutItem
                                        Click="MenuFlyoutItem_Click"
                                        Icon="Delete"
                                        Text="移除" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <PersonPicture
                                Width="56"
                                Height="48"
                                BorderThickness="0"
                                ProfilePicture="{x:Bind Path=Photo}" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Path=UserName}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="{x:Bind Path=SiteName}" />
                            </StackPanel>
                            <StackPanel
                                Grid.ColumnSpan="2"
                                Margin="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{x:Bind Path=IsLive, Mode=OneWay}">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Fill="Green" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="Green"
                                    Text="直播中" />
                            </StackPanel>
                            <StackPanel
                                Grid.ColumnSpan="2"
                                Margin="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{x:Bind Path=IsLoading, Mode=OneWay}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="加载中" />
                            </StackPanel>
                            <StackPanel
                                Grid.ColumnSpan="2"
                                Margin="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{x:Bind Path=IsOffline, Mode=OneWay}">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Fill="Gray" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="未开播" />
                            </StackPanel>

                        </Grid>
                    </DataTemplate>
                </controls:MyAdaptiveGridView.ItemTemplate>
            </controls:MyAdaptiveGridView>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Gray"
                Visibility="{x:Bind Path=favoriteVM.IsEmpty, Mode=OneWay}">
                这里还什么都没有~
            </TextBlock>
        </Grid>
    </Grid>
</Page>
